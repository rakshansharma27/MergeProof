# MergeProof environment variables
# Copy this file to .env and fill in your values.

# OpenAI API key — if absent or DEMO_MODE=true, the app runs in DEMO_MODE
# (findings are clearly labeled as synthetic, not live AI output)
OPENAI_API_KEY=

# Model to use for all LLM calls (defaults to gpt-4o-mini if unset)
OPENAI_MODEL=gpt-4o-mini

# Set to "true" to force DEMO_MODE even when OPENAI_API_KEY is present
DEMO_MODE=false
